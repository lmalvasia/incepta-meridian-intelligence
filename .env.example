# Local development only. Copy this file to .env. Do not put real secrets here.
# If port 5432 is already in use, change POSTGRES_PORT and the port in DATABASE_URL together.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian
API_PORT=3001
VITE_API_URL=http://localhost:3001

# Optional. When AI_API_KEY is set, note tags and quick analysis call this chat model.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-5.5
